{
  "openapi": "3.1.0",
  "info": {
    "title": "Web Intelligence API",
    "description": "Website audit, tech-stack detection, page-to-Markdown, broken-link crawl and PDF/OCR extraction behind one key. Built and maintained by WebIntel Tools (https://jordiben.github.io/). Developed with AI assistance and tested against live websites.",
    "version": "1.0.0",
    "contact": {
      "name": "WebIntel Tools",
      "url": "https://jordiben.github.io/"
    },
    "termsOfService": "https://jordiben.github.io/terms.html"
  },
  "paths": {
    "/v1/health-audit": {
